{
  "name": "nahuelmartinez-web",
  "version": "0.0.0",
  "private": true,
  "description": "Web profesional y portfolio interactivo de Nahuel Martínez",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "node ./scripts/run-with-env.mjs dev:workspace",
    "dev:workspace": "pnpm --filter @portfolio/contracts build && pnpm --filter @portfolio/database build && pnpm --parallel --filter @portfolio/web --filter @portfolio/api dev",
    "dev:web": "node ./scripts/run-with-env.mjs dev:web:workspace",
    "dev:web:workspace": "pnpm --filter @portfolio/web dev",
    "dev:api": "node ./scripts/run-with-env.mjs dev:api:workspace",
    "dev:api:workspace": "pnpm --filter @portfolio/api dev",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:generate": "node ./scripts/run-with-env.mjs db:generate:workspace",
    "db:generate:workspace": "pnpm --filter @portfolio/database db:generate",
    "db:migrate": "node ./scripts/run-with-env.mjs db:migrate:workspace",
    "db:migrate:workspace": "pnpm --filter @portfolio/database db:migrate",
    "db:seed": "node ./scripts/run-with-env.mjs db:seed:workspace",
    "db:seed:workspace": "pnpm --filter @portfolio/database db:seed",
    "db:studio": "node ./scripts/run-with-env.mjs db:studio:workspace",
    "db:studio:workspace": "pnpm --filter @portfolio/database db:studio",
    "lint": "eslint playwright.config.ts tests/e2e && pnpm -r --if-present run lint",
    "typecheck": "tsc --project tsconfig.playwright.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm --filter @portfolio/database test:integration && pnpm --filter @portfolio/api test:integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:web": "pnpm --filter @portfolio/web dev",
    "test:e2e:api": "pnpm --filter @portfolio/contracts build && pnpm --filter @portfolio/database build && pnpm --filter @portfolio/api build && pnpm db:migrate && pnpm --filter @portfolio/api start",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@portfolio/config": "workspace:*",
    "@types/node": "26.6.4",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^6.0.2"
  }
}
