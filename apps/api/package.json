{
  "name": "@portfolio/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "pnpm --filter @portfolio/contracts build && pnpm --filter @portfolio/database build && vitest run tests/unit",
    "test:integration": "pnpm --filter @portfolio/contracts build && pnpm --filter @portfolio/database build && vitest run tests/integration --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@portfolio/contracts": "workspace:*",
    "@portfolio/database": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-plugin": "6.0.0",
    "nodemailer": "^10.0.16",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@portfolio/config": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "5.0.3"
  }
}
