# Runtime
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
API_INTERNAL_ORIGIN=http://127.0.0.1:4000

# PostgreSQL (local development only)
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_local_only
DATABASE_URL=postgresql://portfolio:portfolio_local_only@localhost:5432/portfolio

# Mailpit (local development only)
SMTP_HOST=localhost
MAIL_TRANSPORT=smtp
SMTP_PORT=1025
MAIL_FROM=portfolio@localhost
MAIL_TO=contact@localhost
CONTACT_RATE_LIMIT=5
# Only required when MAIL_TRANSPORT=resend; server-only credential
RESEND_API_KEY=
MAILPIT_UI_URL=http://localhost:8025

# Locale and application
DEFAULT_LOCALE=es
APP_TIMEZONE=America/Argentina/Buenos_Aires

# First-party analytics (server only; replace fictitious key before production)
WEB_ORIGIN=http://localhost:3000
ANALYTICS_COOKIE_SECRET=fictitious-local-only-analytics-key-change-before-production
# Optional UTC day for analytics:aggregate (defaults to yesterday)
# ANALYTICS_DAY=2026-10-08
