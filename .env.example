# Runtime
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# PostgreSQL (local development only)
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_local_only
DATABASE_URL=postgresql://portfolio:portfolio_local_only@localhost:5432/portfolio

# Mailpit (local development only)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=portfolio@localhost
MAILPIT_UI_URL=http://localhost:8025

# Locale and application
DEFAULT_LOCALE=es
APP_TIMEZONE=America/Argentina/Buenos_Aires

